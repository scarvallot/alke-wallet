<!-- 1. Tarjeta de Saldo (Exclusiva para visualización) -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body text-center py-4">
        <!-- Título y Botón de Privacidad -->
        <div class="d-flex justify-content-center align-items-center mb-2">
            <h5 class="card-title text-muted font-weight-normal mb-0">Saldo Disponible</h5>
            <button class="btn btn-sm btn-link text-muted ml-2" id="btn-privacidad" title="Ocultar saldo">
                <i class="fas fa-eye"></i>
            </button>
        </div>

        <!-- Monto del Saldo (Con altura fija para cero parpadeos) -->
        <h1 class="font-weight-bold text-dark" id="balance" style="font-size: clamp(1.5rem, 8vw, 3.5rem); min-height: 65px; display: flex; justify-content: center; align-items: center;">
            <i class="fas fa-circle-notch fa-spin text-muted h3"></i>
        </h1>
        <small class="text-muted d-block">Actualizado en tiempo real</small>
    </div>
</div>