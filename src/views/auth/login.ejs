<div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
        <div class="card login-card p-4 p-sm-5 shadow-sm">
            <div class="card-body text-center">
                <i class="fas fa-wallet fa-3x text-primary mb-3"></i>
                <h1 class="h3 mb-1 login-header">Mi Wallet</h1>
                <p class="login-tagline mb-4 text-muted">
                    <%= locals.tagline || 'Gestiona tu dinero de forma segura' %>
                </p>

                <form id="loginForm" action="/login" method="POST">
                    <div class="form-group text-left">
                        <label for="username" class="font-weight-bold">Usuario</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fa-solid fa-circle-user"></i></span>
                            </div>
                            <input type="text" id="username" name="username" class="form-control form-control-lg" placeholder="Ingresa tu usuario" required />
                        </div>
                    </div>
                    <div class="form-group text-left">
                        <label for="password" class="font-weight-bold">Contraseña</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            </div>
                            <input type="password" id="password" name="password" class="form-control form-control-lg" placeholder="Ingresa tu contraseña" required />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success btn-block btn-lg mt-4" id="loginBtn">
                        <i class="fas fa-sign-in-alt mr-2"></i>Iniciar Sesión
                    </button>
                </form>

                <div class="mt-4 pt-3 border-top text-left small text-muted">
                    <p class="mb-1 font-weight-bold text-dark">Credenciales de prueba:</p>
                    <p class="mb-1">Usuario: <strong>admin</strong></p>
                    <p class="mb-0">Contraseña: <strong>12345</strong></p>
                </div>
            </div>
        </div>
    </div>
</div>