<div class="deposit-container">
  <!-- Encabezado de la página -->
  <div class="row mb-4">
    <div class="col-12">
      <h1 class="mb-0">Depositar Dinero</h1>
      <p class="text-muted mt-2">
        Ingresa fondos a tu billetera virtual de forma segura.
      </p>
    </div>
  </div>

  <!-- Tarjeta de saldo -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body text-center py-4">
      <h5 class="card-title text-muted font-weight-normal">
        Saldo Disponible
      </h5>
      <!-- El ID se mantiene para que tu deposit.js lo lea/actualice dinámicamente -->
      <h1 class="display-4 font-weight-bold text-dark" id="balance">$0</h1>
      <small class="text-muted">Actualizado en tiempo real</small>
    </div>
  </div>

  <!-- Formulario de depósito -->
  <form id="depositForm" class="mb-4">
    <div class="form-group">
      <label for="depositAmount" class="font-weight-bold">Monto a depositar:</label>
      <div class="input-group mb-2">
        <div class="input-group-prepend">
          <span class="input-group-text bg-white">$</span>
        </div>
        <input type="number" class="form-control form-control-lg" id="depositAmount" placeholder="0" min="1000" required />
      </div>
      <small class="form-text text-muted">Monto mínimo: $1.000.- CLP</small>
    </div>

    <!-- Botón Confirmar Depósito -->
    <div class="text-center mt-4">
      <button type="submit" class="btn btn-success px-5 py-3 w-100 shadow-sm" id="depositBtn">
        <i class="fa-solid fa-circle-check mr-2"></i>
        <span class="font-weight-bold">Confirmar Depósito</span>
      </button>
    </div>
  </form>

  <!-- Navegación inferior / Acciones rápidas (Usando <a> para enrutamiento Express) -->
  <div class="card border-0 shadow-sm mb-3 mt-5">
    <div class="card-body p-2">
      <div class="row no-gutters text-center">

        <!-- Botón Enviar Dinero -->
        <div class="col-4 pr-1">
          <a href="/sendmoney" class="btn btn-light w-100 d-flex flex-column align-items-center py-3 text-decoration-none">
            <span class="icon-circle icon-send mb-2">
              <i class="fa-solid fa-money-bill-transfer text-primary"></i>
            </span>
            <span class="small font-weight-bold text-dark">Enviar Dinero</span>
          </a>
        </div>

        <!-- Botón Últimos Movimientos -->
        <div class="col-4 px-1">
          <a href="/transaction" class="btn btn-light w-100 d-flex flex-column align-items-center py-3 text-decoration-none">
            <span class="icon-circle icon-movements mb-2">
              <i class="fa-solid fa-calendar-days text-info"></i>
            </span>
            <span class="small font-weight-bold text-dark">Movimientos</span>
          </a>
        </div>

        <!-- Botón Menú Principal -->
        <div class="col-4 pl-1">
          <a href="/menu" class="btn btn-light w-100 d-flex flex-column align-items-center py-3 text-decoration-none">
            <span class="icon-circle icon-movements mb-2">
              <i class="fa-solid fa-grip text-secondary"></i>
            </span>
            <span class="small font-weight-bold text-dark">Menú</span>
          </a>
        </div>

      </div>
    </div>
  </div>
  <!-- Botón Cerrar Sesión (Apunta al endpoint del backend) -->
  <div class="text-center mt-5">
    <a href="/logout" class="btn btn-danger px-5 py-3 shadow-sm rounded-pill" id="btnCerrarSesion">
      <i class="fa-solid fa-right-from-bracket mr-2"></i>
      <span class="font-weight-bold">Cerrar Sesión</span>
    </a>
  </div>