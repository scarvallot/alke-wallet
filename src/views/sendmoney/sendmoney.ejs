<div class="sendmoney-container">
  <!-- Encabezado de la página -->
  <div class="row mb-4">
    <div class="col-12">
      <h1 class="mb-0">Enviar Dinero</h1>
      <p class="text-muted mt-2">
        Gestiona tus contactos y realiza transferencias.
      </p>
    </div>
  </div>

  <!-- Tarjeta de saldo -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body text-center py-4">
      <h5 class="card-title text-muted font-weight-normal">
        Saldo Disponible
      </h5>
      <!-- El ID se mantiene para que tu sendmoney.js lo actualice dinámicamente -->
      <h1 class="display-4 font-weight-bold text-dark" id="balance">$0</h1>
      <small class="text-muted">Actualizado en tiempo real</small>
    </div>
  </div>

  <!-- Formulario de búsqueda -->
  <form id="searchForm" class="mb-3">
    <div class="input-group">
      <input type="text" class="form-control" id="searchContact" placeholder="Buscar contacto por nombre o alias" />
      <div class="input-group-append">
        <button type="submit" class="btn btn-outline-primary">
          <i class="fas fa-search"></i> Buscar
        </button>
      </div>
    </div>
  </form>

  <!-- Botón agregar contacto -->
  <button type="button" class="btn btn-success btn-block mb-3 shadow-sm" id="btnAgregarContacto">
    <i class="fas fa-user-plus mr-2"></i>Agregar nuevo contacto
  </button>

  <!-- Formulario agregar contacto (oculto por defecto) -->
  <div id="addContactFormContainer" class="card border-0 shadow-sm mb-3" style="display: none">
    <div class="card-body">
      <h6 class="font-weight-bold mb-3">
        <i class="fas fa-user-plus mr-2"></i>Nuevo contacto
      </h6>
      <form id="addContactForm">
        <div class="form-group">
          <label for="contactName">Nombre y apellido</label>
          <input type="text" class="form-control" id="contactName" placeholder="Ej: Juan Pérez" required />
          <small class="text-danger" id="errNombre"></small>
        </div>
        <div class="form-group">
          <label for="contactCbu">CBU (mínimo 10 dígitos)</label>
          <input type="text" class="form-control" id="contactCbu" placeholder="Ej: 0123456789012345678" required />
          <small class="text-danger" id="errCbu"></small>
        </div>
        <div class="form-group">
          <label for="contactAlias">Alias</label>
          <input type="text" class="form-control" id="contactAlias" placeholder="Ej: juan.perez" required />
          <small class="text-danger" id="errAlias"></small>
        </div>
        <div class="d-flex mt-3">
          <button type="submit" class="btn btn-primary mr-2 flex-grow-1">Guardar</button>
          <button type="button" class="btn btn-secondary flex-grow-1" id="btnCancelarContacto">Cancelar</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Lista de contactos -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <h6 class="font-weight-bold mb-3">
        <i class="fas fa-address-book mr-2"></i>Mis Contactos
      </h6>
      <div id="contactList">
        <!-- Tu script sendmoney.js inyectará los contactos aquí -->
      </div>
    </div>
  </div>

  <!-- Navegación inferior / Acciones rápidas (Usando <a> para enrutamiento Express) -->
  <div class="card border-0 shadow-sm mb-3 mt-4">
    <div class="card-body p-2">
      <div class="row no-gutters text-center">

        <!-- Botón Depositar -->
        <div class="col-4 pr-1">
          <a href="/deposit" class="btn btn-light w-100 d-flex flex-column align-items-center py-3 text-decoration-none">
            <span class="icon-circle icon-deposit mb-2">
              <i class="fa-solid fa-money-bill-1-wave"></i>
            </span>
            <span class="small font-weight-bold text-dark">Depositar</span>
          </a>
        </div>

        <!-- Botón Últimos Movimientos -->
        <div class="col-4 px-1">
          <a href="/transaction" class="btn btn-light w-100 d-flex flex-column align-items-center py-3 text-decoration-none">
            <span class="icon-circle icon-movements mb-2">
              <i class="fa-solid fa-calendar-days text-primary"></i>
            </span>
            <span class="small font-weight-bold text-dark">Movimientos</span>
          </a>
        </div>

        <!-- Botón Menú Principal -->
        <div class="col-4 pl-1">
          <a href="/menu" class="btn btn-light w-100 d-flex flex-column align-items-center py-3 text-decoration-none">
            <span class="icon-circle icon-movements mb-2">
              <i class="fa-solid fa-grip text-info"></i>
            </span>
            <span class="small font-weight-bold text-dark">Menú</span>
          </a>
        </div>

      </div>
    </div>
  </div>
</div>