<div class="container dashboard-page mt-3 mt-md-4">
    <h2 class="dashboard-title mb-3 mb-md-4">Gestión de Usuarios</h2>
    <form action="/dashboard" method="GET" class="dashboard-filter mb-4">
        <div class="input-group">
            <input type="text" name="nombre" class="form-control" placeholder="Buscar usuario por nombre..." value="<%= locals.nombreFiltro || '' %>">
            <div class="input-group-append">
                <button class="btn btn-outline-primary" type="submit">
                    <i class="fas fa-search"></i> Filtrar
                </button>
                <% if (locals.nombreFiltro) { %>
                    <a href="/dashboard" class="btn btn-outline-secondary" title="Limpiar filtro">
                        <i class="fas fa-times"></i>
                    </a>
                    <% } %>
            </div>
        </div>
    </form>
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="d-none d-sm-table-cell pl-3 pl-md-4">ID</th>
                            <th>Alias</th>
                            <th class="d-none d-sm-table-cell">Correo</th>
                            <th class="d-none d-sm-table-cell">Estado</th>
                            <th class="d-none d-sm-table-cell">Rol</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% usuarios.forEach((user)=> { %>
                            <tr>
                                <td class="d-none d-sm-table-cell pl-3 pl-md-4">
                                    <%= user.user_id %>
                                </td>
                                <td><strong>
                                        <%= user.user_name %>
                                    </strong></td>
                                <td class="d-none d-sm-table-cell">
                                    <%= user.email %>
                                </td>
                                <td class="d-none d-sm-table-cell">
                                    <span class="badge <%= user.is_active ? 'badge-success' : 'badge-danger' %>">
                                        <%= user.is_active ? 'Activo' : 'Inactivo' %>
                                    </span>
                                </td>
                                <td class="d-none d-sm-table-cell">
                                    <span class="badge badge-info">
                                        <%= user.role || 'user' %>
                                    </span>
                                </td>
                                <td>
                                    <div class="dashboard-actions d-flex flex-column flex-sm-row justify-content-center">
                                        <button class="btn btn-sm btn-outline-primary dashboard-action mb-2 mb-sm-0 mr-sm-1" onclick="editarUsuario('<%= user.user_id %>')">
                                            <i class="fas fa-edit"></i> Editar
                                        </button>
                                        <form id="form-delete-<%= user.user_id %>" action="/usuarios/<%= user.user_id %>" method="POST" class="d-inline">
                                            <button type="button" class="btn btn-sm btn-outline-danger dashboard-action" data-toggle="modal" data-target="#modalConfirmacion" data-userid="<%= user.user_id %>" <%=!user.is_active ? 'disabled' : '' %>>
                                                <i class="fas fa-ban"></i> Desactivar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalConfirmacion" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow">
            <div class="modal-body text-center p-4">
                <div class="text-danger mb-3">
                    <i class="fas fa-user-slash fa-3x"></i>
                </div>
                <h3 class="font-weight-bold mb-3">¿Desactivar usuario?</h3>
                <p class="text-muted mb-4">
                    El usuario perderá el acceso a la plataforma. Podrás revertir este estado más adelante desde este mismo panel.
                </p>
                <div class="modal-actions d-flex flex-column flex-sm-row justify-content-center">
                    <button type="button" class="btn btn-light px-4 mb-2 mb-sm-0 mr-sm-3" data-dismiss="modal">
                        Cancelar
                    </button>
                    <button id="btnConfirmarAccion" type="button" class="btn btn-danger px-4 font-weight-bold">
                        Sí, desactivar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>